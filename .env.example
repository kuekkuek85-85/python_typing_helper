# --- 필수 -----------------------------------------------------------------
# Flask 세션 서명 키. 배포 시 반드시 랜덤 문자열로 설정한다.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# --- Firebase (Firestore) -------------------------------------------------
# 아래 중 하나만 설정하면 된다.
# 1) 서비스 계정 JSON 전체를 한 줄로 넣기 (Render/Railway 등 권장)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# 2) 서비스 계정 키 파일 경로
# FIREBASE_SERVICE_ACCOUNT_FILE=./serviceAccountKey.json
# 3) Google Cloud 기본 자격 증명을 쓰는 환경(Cloud Run 등)에서는 아무것도 설정하지 않아도 된다.

# 프로젝트 ID (서비스 계정 JSON에 포함되어 있으면 생략 가능)
# FIREBASE_PROJECT_ID=

# Firestore 컬렉션 이름
# FIRESTORE_COLLECTION=records

# --- 저장소 선택 ----------------------------------------------------------
# auto(기본) | firestore | local
# local로 두면 Firebase 없이 data/records.json에 저장한다(수업 전 점검용).
# STORE_BACKEND=auto
# LOCAL_DB_PATH=data/records.json

# --- 연습 세션 저장소 ------------------------------------------------------
# 연습 세션(키 입력 집계)과 제출 빈도 제한을 어디에 둘지 정한다.
#
#   memory    : 프로세스 메모리. 단일 워커 배포(Render/Railway/Cloud Run)용.
#   firestore : Firestore 문서. 서버리스(Vercel)용. 인스턴스가 늘어나도 된다.
#   auto(기본): Vercel이면 firestore, 아니면 memory.
#
# 서버리스에서 memory를 쓰면 "타이핑 세션을 찾을 수 없습니다"가 난다.
# 배포 후 /health의 session_backend 값으로 확인한다.
# SESSION_BACKEND=auto

# 브라우저가 키 입력을 묶어 보고하는 간격(밀리초).
# 이 값이 Firestore 쓰기 횟수를 결정한다(5분 연습 / 10초 = 학생당 30여 회).
# 줄이면 비용이 그만큼 늘어난다.
# KEYSTROKE_FLUSH_MS=10000

# --- 선택 ----------------------------------------------------------------
# HTTPS로 서비스할 때 1로 설정
# SESSION_COOKIE_SECURE=1
# LOG_LEVEL=INFO
# PRACTICE_SECONDS=300
# MIN_KEYSTROKES=100
